# Agora DB password (generate with: openssl rand -base64 24)
AGORA_DB_PASSWORD=CHANGEME

# Pepper for hashing (generate with: openssl rand -base64 16)
AGORA_PEPPERS=CHANGEME

# Twilio (optional — leave empty to disable SMS auth)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# Jomhoor SSO (required for desktop QR sign-in)
# Ask sso-svc admins for the Taraaz client secret.
SSO_CLIENT_SECRET=
SSO_URL=https://sso.jomhoor.org
AGORA_ORIGIN=https://taraaz.jomhoor.org
